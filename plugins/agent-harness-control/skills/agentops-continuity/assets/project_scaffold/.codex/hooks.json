{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.agentops-continuity/agentops_continuity.py\" hook",
            "timeout": 5,
            "statusMessage": "Loading AgentOps continuity context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.agentops-continuity/agentops_continuity.py\" hook",
            "timeout": 8,
            "statusMessage": "Updating AgentOps task context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.agentops-continuity/agentops_continuity.py\" hook",
            "timeout": 5,
            "statusMessage": "AgentOps pre-tool guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.agentops-continuity/agentops_continuity.py\" hook",
            "timeout": 8,
            "statusMessage": "AgentOps state update"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.agentops-continuity/agentops_continuity.py\" hook",
            "timeout": 10,
            "statusMessage": "AgentOps stop gate"
          }
        ]
      }
    ]
  }
}