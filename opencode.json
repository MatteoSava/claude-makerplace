{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".agents.md"
  ],
  "default_agent": "makerplace-lead",
  "lsp": {
    "pyright": {
      "command": [
        "uv",
        "run",
        "--with",
        "pyright==1.1.409",
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  }
}
