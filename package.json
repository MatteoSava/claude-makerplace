{
  "name": "@claude-makerplace/opencode-plugin",
  "version": "1.0.0",
  "description": "OpenCode plugin adapter for Claude Makerplace skills, commands, agents, and package context.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./opencode-plugin/index.js",
